# PIN block ISO 9564-1 formato 0 -- valores conhecidos de terceiros.
#
# NAO E VETOR OFICIAL. Ver vectors/MANIFEST.txt para a procedencia e
# para o que estes valores cobrem e o que NAO cobrem.
#
# CLEAR  o bloco em claro, 8 bytes: campo do PIN XOR campo do PAN

[montar]

PIN = 1234
PAN = 5555555551234567
CLEAR = 041261AAAAEDCBA9

PIN = 123456789012
PAN = 5555555551234567
CLEAR = 0C1261032D8226A9

[ler]

PIN = 1234
PAN = 5555555551234567
CLEAR = 041261AAAAEDCBA9

PIN = 123456789
PAN = 5555555551234567
CLEAR = 091261032D8DCBA9

PIN = 1234567890
PAN = 5555555551234567
CLEAR = 0A1261032D82CBA9

PIN = 123456789012
PAN = 5555555551234567
CLEAR = 0C1261032D8226A9

[malformado]

PAN = 5555555551234567
CLEAR = 241261AAAAEDCBA9
ERRO = PIN block is not ISO format 0: control field `2`

PAN = 5555555551234567
CLEAR = 0F1261AAAAEDCBA9
ERRO = PIN length must be between 4 and 12: `15`

PAN = 5555555551234567
CLEAR = 021261AAAAEDCBA9
ERRO = PIN length must be between 4 and 12: `2`

PAN = 5555555551234567
CLEAR = 041261AAAAEDCBAA
ERRO = PIN block filler is incorrect: `FFFFFFFFFC`

PAN = 5555555551234567
CLEAR = 051261AAAAEDCBA9
ERRO = PIN is not numeric: `1234F`

